<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sc_black">

    <com.shadowclient.ff.ui.ParticleView
        android:id="@+id/particle"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <FrameLayout
            android:layout_width="176dp"
            android:layout_height="176dp">

            <View
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_glow" />

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo_shadow_round" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvBrand"
            style="@style/ShadowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.28"
            android:text="@string/brand_upper"
            android:textColor="@color/sc_text"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.8"
            android:text="@string/app_tagline"
            android:textColor="@color/sc_violet_bright"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="3dp"
            android:layout_marginTop="34dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/sc_violet" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="26dp"
        android:alpha="0.45"
        android:text="@string/app_tagline"
        android:textColor="@color/sc_text_faint"
        android:textSize="10sp"
        android:visibility="gone" />
</FrameLayout>
