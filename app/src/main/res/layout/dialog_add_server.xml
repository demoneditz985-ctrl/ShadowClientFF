<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="6dp"
        android:paddingEnd="22dp"
        android:paddingBottom="4dp">

        <TextView
            style="@style/ShadowLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROTOCOL" />

        <Spinner
            android:id="@+id/spType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:autofillHints=""
            android:background="@drawable/bg_input"
            android:hint="Name (e.g. INDIA-01)"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_text_faint"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etHost"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:autofillHints=""
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:hint="Host / IP (e.g. node.example.com)"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_text_faint"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etPort"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:autofillHints=""
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:hint="Port (default 443)"
            android:inputType="number"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_text_faint"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etId"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:autofillHints=""
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:hint="UUID / Password"
            android:inputType="textNoSuggestions"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_text_faint"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etSni"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:autofillHints=""
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:hint="SNI / TLS name (optional)"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_text_faint"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etObfs"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:autofillHints=""
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:hint="Obfs password (Hysteria2 only)"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_text_faint"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.75"
            android:text="@string/node_dialog_hint"
            android:textColor="@color/sc_text_faint"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
